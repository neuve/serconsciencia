{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karensilva",
  "compatibility_date": "2026-09-01",
  "main": "./src/worker/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_astro/*"],
    "not_found_handling": "404-page"
  },
  // Se activan cuando los nameservers ya apunten a Cloudflare.
  // Antes de eso, `wrangler deploy` falla porque la zona sigue pendiente.
  "routes": [
    { "pattern": "karensilva.mx", "custom_domain": true },
    { "pattern": "www.karensilva.mx", "custom_domain": true }
  ]
}
