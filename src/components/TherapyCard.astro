---
interface Props {
  title: string;
  eyebrow: string;
  summary: string;
  tone: string;
  eyebrowColor?: string;
  href: string;
  class?: string;
}

const { title, eyebrow, summary, tone, eyebrowColor = 'var(--cream)', href, class: className } = Astro.props;
---

<a href={href} class:list={['therapy-card', className]} style={{ backgroundColor: tone, '--eyebrow-color': eyebrowColor }}>
  <div class="therapy-card__text">
    <div class="therapy-card__eyebrow">{eyebrow}</div>
    <h3 class="therapy-card__title">{title}</h3>
    <p class="therapy-card__summary">{summary}</p>
  </div>
  <span class="therapy-card__icon" aria-hidden="true"><span class="therapy-card__icon-dot"></span></span>
</a>

<style>
  .therapy-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-radius: var(--r-content);
    padding: var(--box-padding);
    text-align: left;
    transition: filter var(--ease-standard);
  }

  .therapy-card:hover {
    filter: brightness(1.04);
  }

  .therapy-card__eyebrow {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--eyebrow-color, var(--amber));
    margin-bottom: 12px;
  }

  .therapy-card__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.05;
    color: var(--cream);
    margin: 0 0 12px;
  }

  .therapy-card__summary {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(var(--cream-rgb), 0.85);
    margin: 0;
    max-width: 44ch;
  }

  /* Mismo círculo + punto que .philosophy__icon en index.astro (52px con
     un punto de 16px, razón ~0.3), reescalado a la altura del título de
     esta tarjeta en vez del tamaño fijo que tiene en el bloque de filosofía. */
  .therapy-card__icon {
    width: 42px;
    height: 42px;
    border-radius: var(--r-dot);
    border: 1.5px solid var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .therapy-card__icon-dot {
    width: 13px;
    height: 13px;
    border-radius: var(--r-dot);
    background: var(--amber);
    display: block;
  }
</style>
