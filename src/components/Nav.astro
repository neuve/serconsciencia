---
import { Image } from 'astro:assets';
import logoKarenSilva from '../assets/logo-karen-silva.png';
import logoKarenSilvaCrema from '../assets/logo-karen-silva-crema.png';
import { terapias } from '../data/terapias';

interface NavLink {
  href: string;
  label: string;
}

const links: NavLink[] = [
  { href: '/sobre', label: 'Sobre mí' },
  { href: '/terapias', label: 'Terapias' },
  { href: '/comunicacion-animal', label: 'Comunicación animal' },
  { href: '/talleres', label: 'Talleres' },
  { href: '/testimonios', label: 'Testimonios' },
];

/* Barra de escritorio: solo los tres links fijos. El resto vive en el menú
   hamburguesa (igual que en móvil), que ahora se usa en todos los anchos. */
const primaryLinks = links.filter((link) =>
  ['/terapias', '/comunicacion-animal', '/talleres'].includes(link.href)
);

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href + '/');
}

const isTerapiasActive = isActive('/terapias') || currentPath.startsWith('/servicios/');
---

<nav class="nav gutter">
  <a
    href="/"
    class="nav__brand"
    aria-label="Karen Silva — Ir al inicio"
    aria-current={isHome ? 'page' : undefined}
  >
    <Image src={logoKarenSilva} alt="" width={124} height={40} class="nav__logo" />
  </a>

  <div class="nav__links">
    {primaryLinks.map((link) => (
      <a
        href={link.href}
        class="nav__link"
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
  </div>

  <button
    type="button"
    class="nav__burger"
    id="nav-burger"
    aria-expanded="false"
    aria-controls="nav-mobile"
    aria-label="Abrir menú"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<div class="nav__mobile" id="nav-mobile">
  <div class="nav__mobile-header">
    <a
      href="/"
      class="nav__mobile-brand"
      aria-label="Karen Silva — Ir al inicio"
    >
      <Image src={logoKarenSilvaCrema} alt="" width={124} height={40} class="nav__mobile-logo" />
    </a>
    <button
      type="button"
      class="nav__mobile-close"
      id="nav-close"
      aria-label="Cerrar menú"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="nav__mobile-links" aria-label="Menú principal">
    {links.map((link) =>
      link.href === '/terapias' ? (
        <div class="nav__mobile-item">
          <button
            type="button"
            class="nav__mobile-link nav__mobile-toggle"
            aria-expanded="false"
            aria-controls="nav-terapias-sub"
            aria-current={isTerapiasActive ? 'page' : undefined}
          >
            {link.label}
            <span class="nav__mobile-chevron" aria-hidden="true"></span>
          </button>
          <div class="nav__mobile-sub-wrap" id="nav-terapias-sub">
            <ul class="nav__mobile-sub">
              <li>
                <a href="/terapias" class="nav__mobile-sub-link nav__mobile-sub-link--all">
                  Ver todas las terapias
                </a>
              </li>
              {terapias.map((t) => (
                <li>
                  <a href={`/servicios/${t.svc}`} class="nav__mobile-sub-link">
                    {t.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          class="nav__mobile-link"
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      )
    )}
  </nav>

  <div class="nav__mobile-bottom">
    <p class="nav__mobile-support">
      Canalización, registros akáshicos, péndulo y comunicación&nbsp;animal.
    </p>
    <a
      href="https://wa.me/525532407194"
      class="nav__cta nav__cta--mobile"
      target="_blank"
      rel="noopener noreferrer"
    >
      Agendar cita
      <span class="nav__dot" aria-hidden="true"></span>
    </a>
  </div>
</div>

<script>
  const nav = document.querySelector('.nav');
  const burger = document.getElementById('nav-burger');
  const closeBtn = document.getElementById('nav-close');
  const mobile = document.getElementById('nav-mobile');

  let menuOpen = false;

  if (nav && burger && mobile) {
    const closeMenu = () => {
      menuOpen = false;
      mobile.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      nav.classList.remove('nav--hidden-for-menu');
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      menuOpen = true;
      mobile.classList.add('is-open');
      burger.setAttribute('aria-expanded', 'true');
      nav.classList.add('nav--hidden-for-menu');
      document.body.style.overflow = 'hidden';
    };

    burger.addEventListener('click', () => {
      if (menuOpen) closeMenu();
      else openMenu();
    });

    closeBtn?.addEventListener('click', closeMenu);

    mobile.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', closeMenu);
    });

    const terapiasToggle = document.querySelector('.nav__mobile-toggle');
    const terapiasSub = document.getElementById('nav-terapias-sub');

    terapiasToggle?.addEventListener('click', () => {
      const isOpen = terapiasSub?.classList.toggle('is-open');
      terapiasToggle.classList.toggle('is-open', isOpen);
      terapiasToggle.setAttribute('aria-expanded', String(!!isOpen));
    });
  }

  // Auto-hide de la barra: se oculta al bajar, reaparece al subir o al
  // acercar el puntero al borde superior de la ventana.
  if (nav) {
    let lastY = window.scrollY;
    const topThreshold = 12;
    const pointerThreshold = 60;
    let ticking = false;

    const setHidden = (hidden) => {
      if (menuOpen) return;
      nav.classList.toggle('nav--hidden', hidden);
    };

    const onScroll = () => {
      const y = window.scrollY;

      if (y <= topThreshold) {
        setHidden(false);
      } else if (y > lastY) {
        setHidden(true);
      } else if (y < lastY) {
        setHidden(false);
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true }
    );

    window.addEventListener('mousemove', (e) => {
      if (e.clientY <= pointerThreshold) {
        setHidden(false);
      }
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    padding-block: 22px;
    min-height: var(--nav-height);
    background: rgba(var(--cream-rgb), 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline-soft);
    transition: transform var(--ease-standard), background var(--ease-standard);
  }

  .nav--hidden {
    transform: translateY(-100%);
  }

  .nav__brand {
    display: flex;
    align-items: center;
  }

  /* El logo del estudio ya trae el nombre: no lleva wordmark tipográfico al
     lado. Se fija la altura y el ancho se deja libre para no deformarlo. */
  .nav__logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .nav__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 4vw, 56px);
  }

  .nav__link {
    font-size: var(--fs-nav);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    color: var(--ink-mid);
    font-weight: 500;
    transition: color var(--ease-standard);
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--sage);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--cta);
    color: var(--cta-text);
    padding: var(--btn-padding-sm);
    border-radius: var(--r-pill);
    font-size: 11px;
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    font-weight: 600;
    transition: filter var(--ease-standard);
  }

  .nav__cta:hover {
    filter: brightness(0.94);
  }

  .nav__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-dot);
    background: var(--amber);
    flex: none;
  }

  .nav__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    flex: none;
  }

  .nav__burger span {
    display: block;
    width: 26px;
    height: 1.5px;
    background: var(--sage);
  }

  .nav__burger span:nth-child(2) {
    width: 18px;
    align-self: flex-start;
  }

  .nav--hidden-for-menu {
    opacity: 0;
    pointer-events: none;
  }

  /*
    El panel de menú (hamburguesa) ahora es el mismo en cualquier ancho —
    en escritorio complementa los tres links fijos, en móvil es la única
    forma de navegar — así que su estética vive fuera del media query.
  */
  .nav__mobile {
    display: none;
    flex-direction: column;
    position: fixed;
    inset: 0;
    z-index: 70;
    background: var(--sage);
    min-height: 100%;
    overflow-y: auto;
    animation: navMenuFade 0.45s both;
  }

  .nav__mobile.is-open {
    display: flex;
  }

  .nav__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: clamp(56px, 10vh, var(--nav-height));
    padding: 22px var(--gutter) 0;
  }

  .nav__mobile-brand {
    display: flex;
    align-items: center;
  }

  /* Sobre el verde del panel va la variante de una tinta crema, que el estudio
     entregó para fondo oscuro. Antes se teñía la flama con un filtro. */
  .nav__mobile-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  .nav__mobile-close {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    position: relative;
  }

  .nav__mobile-close span {
    position: absolute;
    width: 26px;
    height: 1.5px;
    background: var(--cta);
  }

  .nav__mobile-close span:first-child {
    transform: rotate(45deg);
  }
  .nav__mobile-close span:last-child {
    transform: rotate(-45deg);
  }

  .nav__mobile-links {
    display: flex;
    flex-direction: column;
    margin-top: clamp(16px, 4vh, 40px);
    gap: clamp(0px, 0.6vh, 6px);
    padding-inline: var(--gutter);
  }

  .nav__mobile-link {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 7vw, 42px);
    line-height: 1.15;
    color: var(--cream);
    text-align: left;
    padding: clamp(2px, 1.2vh, 8px) 0;
    animation: navMenuFloat 0.65s both;
  }

  .nav__mobile-link[aria-current='page'] {
    font-style: italic;
    color: var(--cta);
  }

  .nav__mobile-item {
    display: flex;
    flex-direction: column;
  }

  .nav__mobile-toggle {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
  }

  .nav__mobile-chevron {
    flex: none;
    width: 12px;
    height: 12px;
    margin-top: 6px;
    border-right: 1.5px solid var(--cta);
    border-bottom: 1.5px solid var(--cta);
    transform: rotate(45deg);
    transition: transform var(--ease-standard);
  }

  .nav__mobile-toggle.is-open .nav__mobile-chevron {
    transform: rotate(-135deg);
    margin-top: 0;
  }

  .nav__mobile-sub-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  .nav__mobile-sub-wrap.is-open {
    grid-template-rows: 1fr;
  }

  .nav__mobile-sub {
    overflow: hidden;
    min-height: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    padding-left: clamp(14px, 3vw, 22px);
    border-left: 1px solid rgba(var(--cream-rgb), 0.18);
    margin: 4px 0 4px 4px;
  }

  .nav__mobile-sub-link {
    font-family: var(--font-ui);
    font-size: 16px;
    color: rgba(var(--cream-rgb), 0.85);
    padding: 9px 0;
  }

  .nav__mobile-sub-link--all {
    font-weight: 600;
    color: var(--cta);
  }

  .nav__mobile-bottom {
    margin-top: auto;
    padding: clamp(14px, 3vh, 30px) var(--gutter) clamp(20px, 4vh, 40px);
    border-top: 1px solid rgba(var(--cream-rgb), 0.18);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(10px, 2.2vh, 22px);
    animation: navMenuFloat 0.7s 0.15s both;
  }

  .nav__mobile-support {
    font-size: clamp(13px, 2vh, 15px);
    line-height: 1.4;
    color: rgba(var(--cream-rgb), 0.85);
    margin: 0;
    max-width: 40ch;
  }

  .nav__cta--mobile {
    width: fit-content;
  }

  @media (max-width: 880px) {
    .nav__links {
      display: none;
    }
  }

  @keyframes navMenuFade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes navMenuFloat {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
