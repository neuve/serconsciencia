---
interface Props {
  title: string;
  image?: string;
  imagePosition?: string;
  href: string;
  height?: string;
  tag?: string;
  summary?: string;
  bgColor?: string;
  class?: string;
}

const {
  title,
  image,
  imagePosition = 'center',
  href,
  height = '480px',
  tag,
  summary,
  bgColor,
  class: className,
} = Astro.props;
---

<a href={href} class:list={['service-card', className]} style={{ height, backgroundColor: bgColor }}>
  {image && (
    <img
      src={image}
      alt=""
      class="service-card__image"
      style={{ objectPosition: imagePosition }}
    />
  )}
  <div class="service-card__overlay" aria-hidden="true"></div>
  <div class="service-card__top">
    {tag && <div class="service-card__tag">{tag}</div>}
    <h3 class="service-card__title" set:html={title} />
  </div>
  {summary && (
    <div class="service-card__bottom">
      <p class="service-card__summary">{summary}</p>
    </div>
  )}
</a>

<style>
  .service-card {
    position: relative;
    display: block;
    border-radius: var(--r-card);
    overflow: hidden;
    text-align: left;
  }

  .service-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--line-rgb), 0.1), rgba(var(--line-rgb), 0.5));
  }

  .service-card__top {
    position: absolute;
    top: 30px;
    left: 30px;
    right: 30px;
    z-index: 1;
  }

  .service-card__tag {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(var(--cream-rgb), 0.75);
    font-weight: 600;
    margin-bottom: 14px;
  }

  .service-card__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 6.5vw, 32px);
    line-height: 1.02;
    color: var(--cream);
    margin: 0;
    white-space: nowrap;
  }

  .service-card__bottom {
    position: absolute;
    left: 30px;
    right: 30px;
    bottom: 30px;
    z-index: 1;
  }

  .service-card__summary {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(var(--cream-rgb), 0.9);
    margin: 0;
  }
</style>
