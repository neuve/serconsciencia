---
interface Props {
  src: string;
  alt?: string;
  objectPosition?: string;
  class?: string;
}

const { src, alt = '', objectPosition = 'center', class: className } = Astro.props;
---

<img
  src={src}
  alt={alt}
  class:list={['parallax-image', className]}
  data-parallax
  style={{ objectPosition }}
/>

<script>
  // Parallax de scroll reusable vía atributo data-parallax, sin
  // scope compartido entre instancias. Fórmula (ver README del
  // handoff): la imagen se dibuja a height:124%/top:-12% (definido
  // en CSS) y se traslada translateY(offset), con
  // offset = clamp(-40, 40, (centroDelPadre - vh/2) * 0.12),
  // recalculado en requestAnimationFrame sobre un listener de scroll
  // pasivo. Respeta prefers-reduced-motion: si el usuario lo prefiere,
  // el listener nunca se registra y la imagen queda estática.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const images = Array.from(document.querySelectorAll<HTMLImageElement>('[data-parallax]'));

    if (images.length) {
      let ticking = false;

      const clamp = (value: number, min: number, max: number) =>
        Math.min(max, Math.max(min, value));

      const update = () => {
        const vh = window.innerHeight;

        images.forEach((img) => {
          const parent = img.parentElement;
          if (!parent) return;
          const rect = parent.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          const offset = clamp((center - vh / 2) * 0.12, -40, 40);
          img.style.transform = `translateY(${offset}px)`;
        });

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      // El sitio es multipágina (sin ClientRouter), así que cada
      // navegación destruye este contexto de JS y el listener con él.
      // Se desregistra explícitamente igual por si en el futuro se
      // adopta View Transitions (evento astro:before-swap).
      document.addEventListener(
        'astro:before-swap',
        () => {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        },
        { once: true }
      );
    }
  }
</script>

<style>
  .parallax-image {
    position: absolute;
    left: 0;
    right: 0;
    top: -12%;
    width: 100%;
    height: 124%;
    object-fit: cover;
    will-change: transform;
  }
</style>
