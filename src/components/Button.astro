---
interface Props {
  variant?: 'primary' | 'ghost';
  href: string;
  label: string;
  showDot?: boolean;
  class?: string;
}

const { variant = 'primary', href, label, showDot = variant === 'primary', class: className } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  {label}
  {showDot && <span class="btn__dot" aria-hidden="true"></span>}
</a>

<style>
  .btn {
    display: inline-flex;
    /*
      Un botón ajusta siempre al ancho de su texto. Sin esto, dentro de un
      padre flex en columna (o un grid) el stretch por defecto lo estira a
      todo el ancho del contenedor.

      Se usa `width: fit-content` y NO `align-self: start`: el stretch del eje
      transversal solo se aplica cuando ese eje es `auto`, así que un ancho
      definido lo desactiva en un flex en columna sin tocar el eje vertical.
      Con `align-self: start` se rompía el grupo del hero de inicio, donde dos
      botones en un flex en fila se igualaban de alto (el ghost mide 2px más
      por su borde) y quedaban desalineados abajo.

      OJO: nunca añadir `margin` aquí — rompería los grupos de botones del
      hero y del nav. El espaciado del CTA vive en .cta-row.
    */
    width: fit-content; /* padres flex en columna */
    justify-self: start; /* padres grid */
    align-items: center;
    gap: 14px;
    padding: 16px 28px;
    border-radius: var(--r-pill);
    font-size: var(--fs-button);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    font-weight: 600;
    transition: filter var(--ease-standard), background var(--ease-standard),
      opacity var(--ease-standard);
  }

  .btn--primary {
    background: var(--cta);
    color: var(--cta-text);
  }

  .btn--primary:hover {
    filter: brightness(0.94);
  }

  .btn--ghost {
    color: var(--sage);
    border: 1px solid var(--hairline-strong);
    background: transparent;
  }

  .btn--ghost:hover {
    background: var(--overlay-cream-soft);
    opacity: 0.9;
  }

  .btn__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-dot);
    background: var(--amber);
    flex: none;
  }
</style>
