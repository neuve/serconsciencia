---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { services, serviceSlugs } from '../../data/services';
import type { Service } from '../../data/services';
import '../../styles/service-page.css';

export function getStaticPaths() {
  return serviceSlugs.map((slug) => ({
    params: { slug },
    props: { service: services[slug] },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const wa = 'https://wa.me/525532407194';
const textoBloque = service.extra ?? service.sobre;
---

<Base title={service.nombre} description={service.frase}>
  <div class="service-page">
    <!-- 1. Hero centrado -->
    <section class="section hero">
      <div class="gutter">
        <div class="eyebrow-line" style="color: var(--amber);">TERAPIA · {service.eyebrow}</div>
        <h1 class="hero__title">{service.nombre}</h1>
        <p class="hero__lede">{service.frase}</p>
      </div>
    </section>

    <!-- 2. Imagen a sangre (o placeholder degradado si no hay foto) -->
    <section class="bleed hero-image">
      {service.img ? (
        <img
          src={service.img}
          alt={service.nombre}
          style={{ objectPosition: service.imgPos || 'center', objectFit: service.imgFit || 'cover' }}
          class="hero-image__img"
        />
      ) : (
        <div class="hero-image__placeholder" aria-hidden="true"></div>
      )}
    </section>

    <!-- 3. extra / sobre -->
    {textoBloque && (
      <section class="section">
        <div class="gutter">
          <div class="text-block">
            <h2 class="text-block__title">{textoBloque.titulo}</h2>
            {textoBloque.desc.split('\n\n').map((p) => (
              <p class="text-block__desc" set:html={p.replace(/\n/g, '<br />')} />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 4 + 5. Para quién es / no es -->
    {(service.paraQuien?.length || service.noEs) && (
      <section class="section">
        <div class="gutter para-quien-grid">
          {service.paraQuien?.length > 0 && (
            <div>
              <div class="eyebrow-line" style="color: var(--amber);">Para quién es</div>
              <ul class="para-quien-list">
                {service.paraQuien.map((p) => (
                  <li class="para-quien-list__item">
                    <span class="para-quien-list__dot" aria-hidden="true"></span>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {service.noEs && (
            <div class="no-es-box">
              <div class="eyebrow-line" style="color: var(--sage);">Para quién no es</div>
              <p class="no-es-box__text" set:html={service.noEs.replace(/\n/g, '<br />')} />
              {service.noEsNota && <p class="no-es-box__nota">{service.noEsNota}</p>}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 6. Transformaciones -->
    {service.transf?.length > 0 && (
      <section class="section transf-section">
        <div class="gutter">
          <div class="transf-header">
            <div class="eyebrow-line" style="color: var(--amber);">Las 3 transformaciones</div>
            <h2 class="transf-header__title">Lo que te llevas de cada sesión.</h2>
          </div>
          <div class="transf-grid">
            {service.transf.map((t) => (
              <div class="transf-card">
                <div class="transf-card__n">{t.n}</div>
                <h3 class="transf-card__title" set:html={t.titulo.replace(/\n/g, '<br />')} />
                <p class="transf-card__desc" set:html={t.desc.replace(/\n/g, '<br />')} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Primer encuentro -->
    {service.primeraTitulo && (
      <section class="section">
        <div class="gutter">
          <div class="eyebrow-line" style="color: var(--amber); margin-bottom: var(--stack-text);">{service.primeraEyebrow ?? 'CÓMO SON LAS SESIONES'}</div>
          <p class="sessions-text"><strong>{service.primeraTitulo}</strong></p>
          {service.primeraBody?.filter(Boolean).map((p) => (
            <p class="sessions-text" set:html={p.replace(/\n/g, '<br />')} />
          ))}
        </div>
      </section>
    )}

    <!-- 7. Detalles -->
    {service.detalles?.length > 0 && (
      <section class="section section--detalles">
        <div class="gutter detalles-grid">
          {service.detalles.map((d) => (
            <div class="detalle-box">
              <div class="detalle-box__label">{d.label}</div>
              <div class="detalle-box__val" set:html={d.val.replace(/\n/g, '<br />')} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 8. notaExtra (solo doula) -->
    {service.notaExtra && (
      <section class="section">
        <div class="gutter">
          <div class="intro-box">
            {service.notaExtra.label && (
              <div class="eyebrow-line" style="color: var(--amber); margin-bottom: var(--stack-text);">{service.notaExtra.label}</div>
            )}
            <p class="intro-box__text" set:html={service.notaExtra.val.replace(/\n/g, '<br />')} />
          </div>
        </div>
      </section>
    )}

    <!-- 9. pack (solo especiales) -->
    {service.pack && (
      <section class="section pack-section">
        <div class="gutter">
          <div class="eyebrow-line" style="color: var(--amber);">{service.pack.eyebrow}</div>
          <h2 class="pack-section__title">{service.pack.titulo}</h2>
          <p class="pack-section__desc" set:html={service.pack.desc.replace(/\n/g, '<br />')} />
          <div class="transf-grid pack-section__grid">
            {service.pack.pasos.map((p) => (
              <div class="transf-card pack-card">
                <div class="transf-card__n">{p.n}</div>
                <h3 class="transf-card__title" set:html={p.titulo.replace(/\n/g, '<br />')} />
                <p class="transf-card__desc" set:html={p.desc.replace(/\n/g, '<br />')} />
              </div>
            ))}
          </div>
          <p class="pack-section__nota">{service.pack.nota}</p>
        </div>
      </section>
    )}

    <!-- 10. CTA de cierre + Relacionado -->
    <section class="section cta-section">
      <div class="gutter">
        <h2 class="cta-section__title">¿Listo para ordenar tu momento presente?</h2>
        <Button variant="primary" label="Agendar una cita" href={wa} showDot />

        {service.rel && (
          <div class="rel-block">
            <div class="eyebrow-line" style="color: var(--amber);">Te puede interesar</div>
            <a
              href={service.rel.key === 'talleres' ? '/talleres' : `/servicios/${service.rel.key}`}
              class="rel-card"
            >
              <div>
                <div class="rel-card__title">{service.rel.nombre}</div>
                <div class="rel-card__desc">{service.rel.desc}</div>
              </div>
              <span class="rel-card__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        )}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    text-align: center;
    padding-bottom: clamp(40px, 6vh, 70px);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--sage);
    margin: 20px 0 0;
  }

  .hero__lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 22px auto 0;
    max-width: var(--measure-lede);
    text-align: center;
  }

  .hero-image {
    position: relative;
    height: clamp(320px, 46vh, 480px);
    overflow: hidden;
    /* fondo visible en los márgenes cuando una imagen usa imgFit: 'contain'
       (recorte apaisado tan panorámico que 'cover' desenfocaría fotos de
       menor resolución o aspecto muy distinto al de este cajón). */
    background: var(--sand);
  }

  .hero-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-image__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--sage-light), var(--sage));
  }

  .text-block {
    background: var(--sand-mid);
    border-radius: var(--r-content);
    padding: var(--box-padding);
  }

  .text-block__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    color: var(--sage);
    margin: 0 0 var(--stack-text);
  }

  .text-block__desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-body);
    margin: 0 0 16px;
  }

  .no-es-box__nota {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--warm-gray);
    margin: 14px 0 0;
  }

  .detalles-grid {
    display: grid;
    /* auto-fit en vez de columnas fijas: se adapta a 2 o 3 detalles (no todos
       los servicios traen Duración) sin dejar huecos vacíos en la cuadrícula. */
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gap-sm);
  }

  @media (max-width: 780px) {
    .detalles-grid {
      grid-template-columns: 1fr;
    }
  }

  .detalle-box__val {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--sage);
    line-height: 1.3;
  }

  .intro-box__text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-body);
    margin: 0;
  }

  /* Mismo tono que "Talleres y formaciones realizadas" en /talleres. */
  .pack-section {
    background: var(--sage-tone-3);
    border-radius: 0;
  }

  .pack-section__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-h3);
    color: var(--amber);
    margin: 12px 0 18px;
  }

  .pack-section__desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-body);
    margin: 0 0 34px;
    max-width: var(--measure-lede);
  }

  .pack-section__grid {
    margin-bottom: 30px;
  }

  /*
    .transf-card viene del partial pensada para fondo oscuro (texto crema,
    borde claro); sobre este tono hay que devolverla a tinta sobre blanco.
  */
  .pack-card {
    background: var(--white);
    border-color: var(--hairline);
  }

  .pack-section .transf-card__title {
    color: var(--sage);
  }

  .pack-section .transf-card__desc {
    color: var(--ink-body);
  }

  /* --warm-gray es para notas sobre --sand; sobre este tono baja a 1.96:1. */
  .pack-section__nota {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-body);
    margin: 0;
  }
</style>
