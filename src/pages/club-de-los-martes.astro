---
// Vista "El club de los martes". Nuevo taller (encuentros online semanales),
// construida siguiendo el mismo esquema de /talleres (hero con foto + overlay,
// intro, grid de temas, facilitadora + inversión, FAQ).
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import { faqsClub } from '../data/faqs';

const wa = 'https://wa.me/525532407194';

const temas: string[] = [
  'Radiestesia',
  'Meditaciones',
  'Arcángeles',
  'Ejercicios prácticos',
  'Tips de brujis',
  'Conversaciones que aparecen porque el grupo las necesita',
];
---

<Base
  title="El club de los martes"
  description="Péndulo, meditaciones, arcángeles, conversaciones, experimentos... y todo lo que vaya apareciendo. Encuentros online cada martes."
>
  <!-- Hero -->
  <section class="bleed hero">
    <div class="hero__bg" style="background-image: url('/assets/club-martes-33.jpg'); background-position: center;"></div>
    <div class="hero__overlay"></div>
    <div class="gutter hero__content">
      <div class="eyebrow-line" style="color: var(--sage-deep);">Club online · Sólo Chile</div>
      <h1 class="hero__title">El club de <span class="hero__title-italic">los martes.</span></h1>
      <p class="hero__lede">
        Péndulo, meditaciones, arcángeles, conversaciones, experimentos…<br />
        y todo lo que vaya apareciendo.
      </p>
      <div class="hero__chips">
        <div class="chip"><span class="chip__dot" style="background: var(--cta);"></span>Online, sólo Chile</div>
        <div class="chip"><span class="chip__dot" style="background: var(--sand-mid);"></span>18 y 25 de agosto + 1 y 8 de septiembre</div>
        <div class="chip"><span class="chip__dot" style="background: var(--amber);"></span>20 a 21:30 hrs Chile</div>
        <div class="chip"><span class="chip__dot" style="background: var(--sage-light);"></span>Sólo 17 cupos</div>
        <Button variant="primary" label="Reservar mi lugar" href={wa} showDot />
      </div>
    </div>
  </section>

  <!-- Intro + temas + facilitadora + FAQ: mismo fondo (--sand), un solo
       section con bloques separados por --stack-block en vez de padding de
       section duplicado, para no dejar huecos vacíos entre bloques. -->
  <section class="section faq-section">
    <div class="gutter">
      <div class="intro-box">
        <p class="intro-box__text">
          No hay un programa rígido ni un temario interminable. Cada encuentro es una oportunidad
          para explorar herramientas, hacer preguntas, experimentar con distintas técnicas y
          compartir aquello que nos despierta curiosidad. A veces habrá radiestesia, otras
          meditaciones, arcángeles, ejercicios prácticos, tips de brujis o conversaciones que
          simplemente aparecen porque el grupo las necesita.
        </p>
        <p class="intro-box__text intro-box__text--stack">
          Lo único que sí está garantizado es que cada martes nos iremos con una idea nueva, una
          experiencia distinta… y probablemente más de alguna risa.
        </p>
        <p class="intro-box__text intro-box__text--stack">
          Desde la compañía y la guía de lo sutil nos permitiremos soltar las cargas y avanzar más
          livianos en este inicio de semestre. Bienvenid@s!
        </p>
      </div>

      <div class="block-stack">
        <div class="eyebrow-line" style="color: var(--amber); margin-bottom: var(--stack-cta);">¿Qué puede aparecer cada martes?</div>
        <div class="aprender-grid">
          {temas.map((t) => (
            <div class="aprender-item">
              <span class="aprender-item__dot" aria-hidden="true"></span>
              <div class="aprender-item__text">{t}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="block-stack facilitadora-grid">
        <div class="facilitadora-box">
          <div class="eyebrow-line" style="color: var(--sage-light);">Quién lo facilita</div>
          <h3 class="facilitadora-box__nombre">Karen Silva</h3>
          <p class="facilitadora-box__desc">
            Terapeuta energética formada en Terapia de Respuesta Espiritual, registros akáshicos,
            comunicación animal y péndulo. Acompaña procesos de sanación en CDMX y online.
          </p>
          <a href="/sobre" class="facilitadora-box__link">Conocer más</a>
        </div>
        <div class="inversion-box">
          <div class="eyebrow-line" style="color: var(--amber);">Inversión</div>
          <div class="inversion-box__price">
            $ <span class="inversion-box__price-value">38.000</span> CLP
          </div>
          <p class="inversion-box__incluye">
            Total por los 4 encuentros. Transferencia a la cuenta Santander — envía tu comprobante
            a s3rconsciencia@gmail.com para confirmar tu asistencia.
          </p>
          <Button variant="primary" label="Reservar mi lugar" href={wa} showDot class="inversion-box__cta" />
        </div>
      </div>

      <div class="block-stack">
        <div class="eyebrow-line" style="color: var(--amber); text-align: center; margin-bottom: var(--stack-cta);">
          Preguntas del club
        </div>
        <Faq items={faqsClub} />
      </div>
    </div>
  </section>
</Base>

<style>
  .eyebrow-line {
    font-family: var(--font-ui);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 8vh, 100px) 0;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 35%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.2) 45%, rgba(255, 255, 255, 0) 70%);
  }

  .hero__content {
    position: relative;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 6vw, 86px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 24px 0 0;
    color: var(--ink);
    max-width: 16ch;
  }

  .hero__title-italic {
    font-style: italic;
  }

  .hero__lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 28px 0 0;
    max-width: var(--measure-lede);
  }

  .hero__chips {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 34px;
    align-items: center;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 9px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--hairline);
    padding: 10px 18px;
    border-radius: var(--r-pill);
    font-size: 13px;
    color: var(--ink);
  }

  .chip__dot {
    width: 7px;
    height: 7px;
    border-radius: var(--r-dot);
  }

  .section {
    padding: var(--section-py) 0;
    background: var(--sand);
  }

  .intro-box {
    background: var(--sand-mid);
    border-radius: var(--r-content);
    padding: clamp(34px, 5vw, 56px);
  }

  .intro-box__text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-body);
    margin: 0;
  }

  .intro-box__text--stack {
    margin-top: var(--stack-text);
  }

  .block-stack {
    margin-top: var(--stack-block);
  }

  .aprender-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 32px;
  }

  @media (max-width: 640px) {
    .aprender-grid {
      grid-template-columns: 1fr;
    }
  }

  .aprender-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .aprender-item__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: var(--r-dot);
    background: var(--amber);
    margin-top: 8px;
  }

  .aprender-item__text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-mid);
  }

  .facilitadora-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    align-items: stretch;
  }

  @media (max-width: 720px) {
    .facilitadora-grid {
      grid-template-columns: 1fr;
    }
  }

  .facilitadora-box {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--r-band);
    padding: var(--box-padding);
  }

  .facilitadora-box__nombre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    color: var(--sage);
    margin: 14px 0 14px;
  }

  .facilitadora-box__desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-body);
    margin: 0;
  }

  .facilitadora-box__link {
    display: inline-block;
    margin-top: 22px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage);
    font-weight: 600;
    border-bottom: 1px solid var(--sage);
    padding-bottom: 4px;
  }

  .inversion-box {
    background: var(--sage);
    border-radius: var(--r-band);
    padding: var(--box-padding);
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .inversion-box__price {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    color: var(--white);
    line-height: 1;
    margin-top: 18px;
  }

  .inversion-box__price-value {
    font-weight: 600;
  }

  .inversion-box__incluye {
    font-size: 14px;
    line-height: 1.5;
    color: var(--white);
    margin: 14px 0 24px;
  }

  .inversion-box :global(.inversion-box__cta) {
    margin-inline: auto;
  }

  .faq-section {
    padding-bottom: clamp(80px, 11vh, 130px);
  }
</style>
