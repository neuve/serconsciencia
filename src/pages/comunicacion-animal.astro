---
// Vista dedicada a Comunicación Animal. Hardcodeada según el prototipo
// `prototype/design_handoff_karen_silva/design/Karen Silva Sitio.dc.html` (líneas ~544-664).
// Solo referencia `services.doula` para el link de la banda intermedia.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { services } from '../data/services';
import '../styles/service-page.css';

const animalParaQuien = [
  'Tu compañero animal tiene un tema de salud recurrente: enfermedad, tratamiento, una cirugía próxima, o sospechas que algo le pasa.',
  'Hay comportamientos o hábitos que necesitas entender o negociar con él.',
  'Está en un proceso de enfermedad grave o de final de vida.',
  'Quieres saber cómo brindarle una mejor calidad de vida.',
];

const transformaciones = [
  { n: '01', titulo: 'Entender qué necesita', desc: 'Comprendes lo que tu animal siente y necesita, más allá de las suposiciones.' },
  { n: '02', titulo: 'Un vínculo más fuerte', desc: 'La relación entre tú y tu animal se vuelve más cercana, clara y confiada.' },
  { n: '03', titulo: 'Consciencia sobre tu proceso personal', desc: 'El animal te muestra con claridad que partes de tu proceso están afectando en su experiencia de vida.' },
];

const wa = 'https://wa.me/525532407194';
const doula = services.doula;
---

<Base
  title="Comunicación animal"
  description="Un puente con nuestros compañeros de otras especies, que facilita entender cómo se sienten, qué quieren o necesitan y cómo podemos acompañarlos."
>
  <div class="service-page">
    <!-- Hero -->
    <section class="gutter hero anim-fade">
      <div class="eyebrow-line" style="color: var(--amber);">Servicio · acompañamiento animal</div>
      <h1 class="hero__title">Comunicación <span class="hero__title-italic">animal.</span></h1>
      <p class="hero__lede">
        Un puente con nuestros compañeros de otras especies, que facilita entender cómo se sienten, qué
        quieren o necesitan y cómo podemos acompañarlos.
      </p>
    </section>

    <!-- Foto a sangre -->
    <section class="bleed photo-band">
      <img
        src="/assets/caballo-cafe-blanco.jpg"
        alt="Karen con caballo café y caballo blanco"
        class="photo-band__img"
        style={{ objectPosition: '50% 42%' }}
      />
    </section>

    <!-- Introducción -->
    <section class="section">
      <div class="gutter">
        <div class="intro-box">
          <div class="eyebrow-line" style="color: var(--sage);">COMUNICACIÓN ANIMAL</div>
          <p class="intro-box__text">
            La comunicación interespecie nos ayuda como tutores y responsables a comprender los
            comportamientos de nuestro compañero animal, identificar hábitos que podrían requerir un
            cambio y acompañarlos en procesos de enfermedad, muerte o intervenciones médicas.
            <br />
            Es una guía profunda — y muchas veces sorprendente — sobre la forma en que experimenta su
            vida tu animal, permitiéndote aprender a escuchar y comprender su sentir, y por consecuencia
            fomentar un vínculo más profundo, equilibrado y respetuoso.
          </p>
        </div>
      </div>
    </section>

    <!-- Para quién es / no es -->
    <section class="section">
      <div class="gutter para-quien-grid">
        <div>
          <div class="eyebrow-line" style="color: var(--amber);">Para quién es</div>
          <ul class="para-quien-list">
            {animalParaQuien.map((p) => (
              <li class="para-quien-list__item">
                <span class="para-quien-list__dot" aria-hidden="true"></span>
                {p}
              </li>
            ))}
          </ul>
        </div>
        <div class="no-es-box">
          <div class="eyebrow-line" style="color: var(--sage);">Para quién no es</div>
          <p class="no-es-box__text">
            Para quien no cree que los animales pueden comunicarnos sus necesidades. Este trabajo es
            para quienes respetan la vida animal y quieren darle voz y elección en su propia vida.
          </p>
        </div>
      </div>
    </section>

    <!-- Las 3 transformaciones -->
    <section class="section transf-section">
      <div class="gutter">
        <div class="transf-header">
          <div class="eyebrow-line" style="color: var(--amber);">Las 3 transformaciones</div>
          <h2 class="transf-header__title">Lo que cambia para ti y tu animal.</h2>
        </div>
        <div class="transf-grid">
          {transformaciones.map((t) => (
            <div class="transf-card">
              <div class="transf-card__n">{t.n}</div>
              <h3 class="transf-card__title">{t.titulo}</h3>
              <p class="transf-card__desc">{t.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Banda Doula -->
    <section class="section section--flush-bottom">
      <div class="gutter">
        <a href="/servicios/doula" class="doula-band">
          <div>
            <h3 class="doula-band__title">{doula.frase.split(' — ')[0]}</h3>
            <p class="doula-band__subtitle">Doula del alma animal.</p>
          </div>
          <span class="doula-band__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- Cómo son las sesiones -->
    <section class="section">
      <div class="gutter">
        <div class="eyebrow-line" style="color: var(--amber); margin-bottom: var(--stack-text);">CÓMO SON LAS SESIONES</div>
        <p class="sessions-text">
          <strong>Cada sesión se estructura en dos partes:</strong><br />
          <strong>Envío de información.</strong> Me compartes fotos de tu animal, tu motivo de consulta y
          las preguntas que deseas hacerle. En esta parte coordinamos sobre tus objetivos de la sesión,
          la historia del animal y la situación actual que te lleva a querer saber cómo está y qué
          necesita de ti.
        </p>
        <p class="sessions-text">
          <strong>Encuentro de devolución.</strong> Nos reunimos online para conversar sobre lo que tu
          animal respondió y resolver tus dudas, este encuentro puede ser grabado para que puedas volver
          a integrar la información y/o detalles que en vivo se pueden ir.
        </p>
      </div>
    </section>

    <!-- Detalles -->
    <section class="section section--detalles">
      <div class="gutter detalles-grid">
        <div class="detalle-box">
          <div class="detalle-box__label">Duración</div>
          <div class="detalle-box__val">45 min + seguimiento</div>
        </div>
        <div class="detalle-box">
          <div class="detalle-box__label">Modalidad</div>
          <div class="detalle-box__val">Online</div>
        </div>
      </div>
    </section>

    <!-- CTA final + Te puede interesar -->
    <section class="section cta-section">
      <div class="gutter">
        <h2 class="cta-section__title">¿Quieres saber cómo se siente tu animal?</h2>
        <Button variant="primary" label="Agendar una sesión" href={wa} showDot />

        <div class="rel-block">
          <div class="eyebrow-line" style="color: var(--amber);">Te puede interesar</div>
          <a href="/servicios/canal" class="rel-card">
            <div>
              <div class="rel-card__title">Canalización y registros akáshicos</div>
              <div class="rel-card__desc">Claridad y limpieza de los bloqueos que hoy te detienen.</div>
            </div>
            <span class="rel-card__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    /*
      padding-block, NO el atajo `padding`: este elemento también lleva
      .gutter, y el atajo reseteaba padding-inline a 0 (el estilo scoped
      de Astro gana en especificidad), dejando el texto pegado al borde.
    */
    padding-block: clamp(50px, 7vh, 90px) clamp(40px, 5vh, 60px);
    background: var(--sand);
    text-align: center;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 5.6vw, 80px);
    line-height: 1;
    letter-spacing: -0.015em;
    margin: 22px 0 0;
    color: var(--sage);
  }

  .hero__title-italic {
    font-style: italic;
    color: var(--sage);
  }

  .hero__lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-body);
    margin: 28px auto 0;
    max-width: var(--measure-lede);
  }

  .photo-band {
    position: relative;
    height: clamp(340px, 52vh, 540px);
    overflow: hidden;
    background: var(--sand);
  }

  .photo-band__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-box__text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-body);
    margin: var(--stack-text) 0 0;
  }

  .doula-band {
    display: flex;
    align-items: center;
    gap: 26px;
    width: 100%;
    text-align: left;
    background: var(--sage-deep);
    border-radius: var(--r-band);
    padding: var(--box-padding);
  }

  .doula-band__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
    color: var(--white);
    margin: 0 0 12px;
  }

  .doula-band__subtitle {
    font-size: 15px;
    line-height: 1.55;
    color: var(--amber);
    margin: 0;
    font-style: italic;
  }

  .doula-band__arrow {
    flex: none;
    margin-left: auto;
    font-family: var(--font-display);
    font-size: 34px;
    color: var(--cyan);
  }

  .detalles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-sm);
  }

  @media (max-width: 640px) {
    .detalles-grid {
      grid-template-columns: 1fr;
    }
  }

  .detalle-box__val {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--sage);
  }
</style>
