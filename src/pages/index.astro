---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import Faq from '../components/Faq.astro';
import { testimoniosFull } from '../data/testimonios';
import { faqsHome } from '../data/faqs';

const destacados = testimoniosFull.filter((t) => t.destacado);
---

<Base title="Inicio">
  <!-- HERO -->
  <section class="hero bleed">
    <img src="/assets/hero-yo-11.jpg" alt="" class="hero__bg anim-zoom" />
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__bottom gutter">
      <Eyebrow text="Karen Silva · Terapias y Talleres" color="var(--cream)" class="anim-float hero__eyebrow" />
      <p class="hero__lede anim-fade">Acompaño a humanos y animales<br />en sus procesos de sanación.</p>
      <h1 class="hero__title anim-float-delay-1">reconectando<br />con la <em>consciencia del amor</em></h1>
      <div class="hero__ctas anim-float-delay-2">
        <Button variant="primary" label="Comienza tu camino" href="/terapias" showDot />
        <Button variant="ghost" label="Talleres" href="/talleres" showDot />
      </div>
    </div>
  </section>

  <!-- FILOSOFÍA -->
  <section class="philosophy-section">
    <div class="gutter">
      <div class="philosophy">
        <div class="philosophy__image">
          <img src="/assets/karen-retrato.jpg" alt="Karen Silva" class="philosophy__img" />
        </div>
        <div class="philosophy__text">
          <div class="philosophy__icon" aria-hidden="true"><span></span></div>
          <Eyebrow text="Mi filosofía" color="var(--cyan)" />
          <p class="philosophy__quote">
            <span class="philosophy__quote-amber">
              Mi objetivo principal es ayudarte tener mayor claridad y sabiduría en tu camino de
              vida. Dándole un espacio en lo cotidiano al mundo sutil y espiritual que está en y
              con nosotros.
            </span>
            <span class="philosophy__quote-sage">
              Creo profundamente en la capacidad infinita que tenemos de transformarnos, y estoy
              feliz de poder acompañarte en eso.
            </span>
          </p>
          <div class="cta-row">
            <Button variant="primary" label="Conoce a Karen" href="/sobre" showDot />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="services">
    <SectionHeader
      eyebrow="Terapias y servicios"
      title="Cada camino es distinto."
      lede="Estas son algunas de las puertas de entrada a tu proceso."
    />
    <div class="services__grid gutter">
      <ServiceCard
        title="Canalización y TRE"
        image="/assets/abuelo.avif"
        imagePosition="58% 62%"
        href="/servicios/canal"
        height="480px"
        summary="Trabajo de profunda investigación y limpieza de tus registros del alma."
      />
      <ServiceCard
        title="Comunicación animal"
        image="/assets/karen-caballo.jpg"
        imagePosition="62% 18%"
        href="/comunicacion-animal"
        height="480px"
        summary="Un puente de corazón a corazón con tus compañeros de otras especies."
      />
      <ServiceCard
        title="Especiales"
        image="/assets/bosque.jpg"
        imagePosition="50% 40%"
        href="/servicios/especiales"
        height="480px"
        summary="Encuentros diseñados a tu medida para momentos que se salen del catálogo regular."
      />
    </div>

    <!-- SERVICIOS SECUNDARIOS -->
    <div class="secondary-services gutter">
      <a href="/servicios/rosas" class="secondary-card">
        <div class="secondary-card__text">
          <h3 class="secondary-card__title">Sanación cuántica con Rosas</h3>
          <p class="secondary-card__summary">
            La medicina de las rosas es una técnica psico-espiritual profunda para abrir el
            corazón y, desde la energía del amor, transformar patrones de raíz.
          </p>
        </div>
        <span class="secondary-card__icon" aria-hidden="true"><span class="secondary-card__icon-dot"></span></span>
      </a>
      <a href="/servicios/ankh" class="secondary-card">
        <div class="secondary-card__text">
          <h3 class="secondary-card__title">Sanación con Cruz Ankh</h3>
          <p class="secondary-card__summary">
            Limpieza minuciosa de todo tipo de energías mal calificadas que pueden vivirse como
            ataques energéticos y bloqueos — envidias, mal de ojo, trabajos dirigidos.
          </p>
        </div>
        <span class="secondary-card__icon" aria-hidden="true"><span class="secondary-card__icon-dot"></span></span>
      </a>
    </div>
  </section>

  <!-- LEAD MAGNET -->
  <LeadMagnet
    title="Meditación para armonizar y"
    italicWord="enraizar."
    description="Lleva tu cuerpo a un espacio de tranquilidad, seguridad y comodidad. Un audio guiado para entrenar tu propio poder de autorregulación — uno de los grandes regalos que hoy puedes hacerte."
  />

  <!-- TESTIMONIOS -->
  <section class="testimonials">
    <SectionHeader eyebrow="Historias" title="Cómo cambian los" italicWord="relatos." />
    <div class="testimonials__grid gutter">
      {destacados.map((t) => (
        <TestimonialCard quote={t.quote} name={t.name} service={t.service} />
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <SectionHeader eyebrow="Preguntas frecuentes" title="Antes de agendar." />
    <div class="faq-section__wrap gutter">
      <Faq items={faqsHome} />
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--sand);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(var(--line-rgb), 0.4) 0%,
      rgba(var(--line-rgb), 0.08) 42%,
      transparent 62%
    );
  }

  .hero__bottom :global(.hero__eyebrow) {
    font-weight: 800;
  }

  .hero__lede {
    /* El quiebre lo fuerza un <br /> en el markup: la ventana de anchos que
       lo lograría es de solo ~22px y no sobrevive a cambios de fuente. */
    max-width: 420px;
    font-size: 16px;
    line-height: 1.7;
    font-weight: 600;
    color: var(--cream);
    margin: 14px 0 0;
  }

  .hero__bottom {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(44px, 7vh, 92px);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: -0.02em;
    color: var(--cream);
    margin: 18px 0 0;
  }

  .hero__title em {
    font-style: italic;
  }

  .hero__ctas {
    display: flex;
    gap: var(--gap-sm);
    flex-wrap: wrap;
    margin-top: 34px;
  }

  .hero__ctas :global(.btn--ghost) {
    color: var(--ink);
    background: var(--sage-tone-3);
    border-color: var(--sage-tone-3);
  }

  /* ---------- Filosofía ---------- */
  .philosophy-section {
    padding: var(--section-py-compact) 0;
    background: var(--sand);
  }

  .philosophy {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 0;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--r-split);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    align-items: stretch;
    transform: translateZ(0);
  }

  .philosophy__image {
    position: relative;
    overflow: hidden;
    min-height: clamp(360px, 56vh, 560px);
    /* habilita cqw: 1cqw = 1% del ANCHO de este hueco (ver .philosophy__img) */
    container-type: inline-size;
  }

  /*
    Composición: la mirada del retrato queda fijada en el tercio superior del
    encuadre (regla de tercios), no pegada al borde de arriba.

    En el original (960×1280, ratio 0.75) la mirada está al 18% de la altura.
    La foto se dibuja a `--k` veces el ancho del hueco, así que la distancia
    de los ojos a su borde superior es 18% × (ancho / 0.75) = 24% del ancho,
    escalado por --k. Con `cqw` (1% del ancho del hueco) se puede mezclar esa
    medida con el 33.333% de `top`, que resuelve contra el ALTO:

      top = 33.333% (alto)  −  24cqw × --k (ancho)   ⇒ mirada exacta en 1/3

    El `min(0px, …)` es el tope: si la fila queda tan alta que ese cálculo
    daría positivo, la imagen se pega arriba en lugar de dejar un hueco
    blanco — la mirada sube un poco pero sigue dentro del tercio superior.
    --k: 1.3 hace que el 1/3 sea exacto en escritorio y en móvil.
  */
  .philosophy__img {
    --k: 1.3;
    position: absolute;
    width: calc(100% * var(--k));
    /* el reset global usa img { max-width: 100% }, que capaba el zoom --k */
    max-width: none;
    height: auto;
    left: 50%;
    margin-left: calc(-50% * var(--k));
    top: min(0px, calc(33.333% - 24cqw * var(--k)));
  }

  .philosophy__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 4vw, 48px);
  }

  .philosophy__icon {
    width: 52px;
    height: 52px;
    margin-bottom: 24px;
    border-radius: var(--r-dot);
    border: 1.5px solid var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .philosophy__icon span {
    width: 16px;
    height: 16px;
    border-radius: var(--r-dot);
    background: var(--amber);
    display: block;
  }

  .philosophy__quote {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(19px, 1.9vw, 23px);
    line-height: 1.4;
    margin: var(--stack-text) 0 0;
  }

  .philosophy__quote-amber {
    color: var(--amber);
  }

  .philosophy__quote-sage {
    color: var(--sage);
  }

  .philosophy__quote-amber::after {
    content: ' ';
  }

  @media (max-width: 900px) {
    .philosophy {
      grid-template-columns: 1fr;
    }

    .philosophy__image {
      min-height: 46vh;
    }
  }

  /* ---------- Servicios ---------- */
  .services {
    padding: var(--section-py-compact) 0;
    background: var(--sand);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
    margin-top: var(--stack-section-head);
  }

  .secondary-services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gap);
    margin-top: var(--grid-gap);
  }

  .secondary-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-radius: var(--r-card);
    padding: var(--card-padding);
    text-align: left;
    background-color: var(--sage);
    transition: filter var(--ease-standard);
  }

  .secondary-card:hover {
    filter: brightness(1.04);
  }

  .secondary-card__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    color: var(--cyan);
    margin: 0 0 8px;
  }

  .secondary-card__summary {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(var(--cream-rgb), 0.85);
    margin: 0;
    max-width: 44ch;
  }

  /* Mismo círculo + punto que .philosophy__icon, reescalado al título de
     24px de esta tarjeta (vs. 23px de la cita de filosofía). */
  .secondary-card__icon {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--r-dot);
    border: 1.5px solid var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .secondary-card__icon-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--r-dot);
    background: var(--amber);
    display: block;
  }

  /* ---------- Testimonios ---------- */
  .testimonials {
    padding: var(--section-py-wide) 0;
    background: var(--sand);
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
    margin-top: var(--stack-section-head);
  }

  /* ---------- FAQ ---------- */
  .faq-section {
    padding: var(--section-py-wide) 0;
    background: var(--sand-mid);
  }

  /*
    El max-width vive en el contenido, no en el wrapper: si se aplica al
    mismo elemento que .gutter, el padding del gutter queda DENTRO de los
    900px y las hairlines del FAQ dejan de alinear con el resto del sitio.
  */
  .faq-section__wrap {
    margin-top: var(--stack-section-head);
  }

  .faq-section__wrap :global(.faq) {
    max-width: 900px;
    margin-inline: auto;
  }

  @media (max-width: 900px) {
    .services__grid,
    .secondary-services,
    .testimonials__grid {
      grid-template-columns: 1fr;
    }

  }
</style>
